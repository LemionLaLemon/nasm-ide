{
    "name": "nasm-ide",
    "displayName": "NASM IDE",
    "description": "Language Server Protocol-based IntelliSense, hover docs, cross-file extern support, library-aware diagnostics, build tasks, and a gdb debugger for NASM-style x86/x86_64 assembly.",
    "version": "0.3.0",
    "publisher": "lemion",
    "author": {
        "name": "lemion"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/lemion/nasm-ide.git"
    },
    "bugs": {
        "url": "https://github.com/lemion/nasm-ide/issues"
    },
    "homepage": "https://github.com/lemion/nasm-ide#readme",
    "keywords": [
        "assembly",
        "x86",
        "x64",
        "nasm",
        "intel",
        "asm",
        "linker",
        "debugger",
        "gdb"
    ],
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages",
        "Debuggers"
    ],
    "activationEvents": [
        "onLanguage:nasm",
        "onDebug",
        "onDebugInitialConfigurations",
        "onDebugResolve:nasm"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "nasm",
                "aliases": [
                    "NASM",
                    "nasm",
                    "x86 Assembly"
                ],
                "extensions": [
                    ".asm",
                    ".nasm",
                    ".inc"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "nasm",
                "scopeName": "source.nasm",
                "path": "./syntaxes/nasm.tmLanguage.json"
            }
        ],
        "debuggers": [
            {
                "type": "nasm",
                "label": "NASM (gdb)",
                "languages": [
                    "nasm"
                ],
                "program": "./out/debugAdapter.js",
                "runtime": "node",
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Path to the unstripped ELF executable to debug."
                            },
                            "args": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "default": [],
                                "description": "Command-line arguments passed to the program."
                            },
                            "cwd": {
                                "type": "string",
                                "default": "${workspaceFolder}",
                                "description": "Working directory for the program and gdb."
                            },
                            "console": {
                                "type": "string",
                                "enum": [
                                    "internalConsole",
                                    "integratedTerminal",
                                    "externalTerminal"
                                ],
                                "default": "integratedTerminal",
                                "description": "Where the program runs. Use integratedTerminal for ncurses, X11, or programs that need a TTY; internalConsole runs with pipe-based stdin/stdout."
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "default": false,
                                "description": "Stop at the program entry point."
                            },
                            "env": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "description": "Environment variables for the program."
                            },
                            "gdbPath": {
                                "type": "string",
                                "default": "gdb",
                                "description": "Path to the gdb executable."
                            },
                            "gdbserverPath": {
                                "type": "string",
                                "default": "gdbserver",
                                "description": "Path to the gdbserver executable."
                            }
                        }
                    },
                    "attach": {
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Optional unstripped ELF executable used for symbols."
                            },
                            "processId": {
                                "type": "number",
                                "description": "PID to attach to with gdb."
                            },
                            "host": {
                                "type": "string",
                                "default": "127.0.0.1",
                                "description": "gdbserver host."
                            },
                            "port": {
                                "type": "number",
                                "description": "gdbserver port."
                            },
                            "cwd": {
                                "type": "string",
                                "default": "${workspaceFolder}"
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "default": false
                            },
                            "gdbPath": {
                                "type": "string",
                                "default": "gdb"
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "nasm",
                        "request": "launch",
                        "name": "Debug NASM program",
                        "program": "${workspaceFolder}/bin/${workspaceFolderBasename}",
                        "cwd": "${workspaceFolder}",
                        "console": "integratedTerminal",
                        "stopOnEntry": true
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "NASM: Launch program (make + gdb)",
                        "description": "Build with make, then run the ELF under gdb in an integrated terminal.",
                        "body": {
                            "type": "nasm",
                            "request": "launch",
                            "name": "Debug NASM program (gdb)",
                            "program": "${workspaceFolder}/build/${workspaceFolderBasename}",
                            "cwd": "${workspaceFolder}",
                            "console": "integratedTerminal",
                            "stopOnEntry": true,
                            "preLaunchTask": "NASM IDE: make"
                        }
                    },
                    {
                        "label": "NASM: Launch in Debug Console (no TTY)",
                        "description": "Run gdb directly; program stdin/stdout are pipes. Good for headless programs and tests.",
                        "body": {
                            "type": "nasm",
                            "request": "launch",
                            "name": "Debug NASM program (console)",
                            "program": "${workspaceFolder}/build/${workspaceFolderBasename}",
                            "cwd": "${workspaceFolder}",
                            "console": "internalConsole",
                            "stopOnEntry": true,
                            "preLaunchTask": "NASM IDE: make"
                        }
                    },
                    {
                        "label": "NASM: Attach to gdbserver",
                        "description": "Attach to a program already running under gdbserver.",
                        "body": {
                            "type": "nasm",
                            "request": "attach",
                            "name": "Attach to gdbserver",
                            "host": "127.0.0.1",
                            "port": 1234,
                            "program": "${workspaceFolder}/build/${workspaceFolderBasename}",
                            "cwd": "${workspaceFolder}"
                        }
                    }
                ]
            }
        ],
        "breakpoints": [
            {
                "language": "nasm"
            }
        ],
        "configuration": {
            "title": "NASM IDE",
            "properties": {
                "nasmIde.nasmPath": {
                    "type": "string",
                    "default": "nasm",
                    "description": "Path to the nasm assembler executable."
                },
                "nasmIde.arch": {
                    "type": "string",
                    "enum": [
                        "x86",
                        "x86_64"
                    ],
                    "default": "x86_64",
                    "description": "Target architecture used when running nasm for diagnostics (elf32 vs elf64)."
                },
                "nasmIde.diagnostics.enable": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable nasm + workspace diagnostics."
                },
                "nasmIde.diagnostics.mode": {
                    "type": "string",
                    "enum": [
                        "asYouType",
                        "onSave"
                    ],
                    "default": "asYouType",
                    "description": "asYouType runs nasm in the background (debounced) as you edit; onSave only runs on save."
                },
                "nasmIde.diagnostics.debounceMs": {
                    "type": "integer",
                    "default": 400,
                    "minimum": 0,
                    "maximum": 5000,
                    "description": "Debounce delay in milliseconds before as-you-type diagnostics run."
                },
                "nasmIde.diagnostics.unresolvedExterns": {
                    "type": "boolean",
                    "default": true,
                    "description": "Warn on `extern` symbols defined neither in the workspace nor in any configured library."
                },
                "nasmIde.diagnostics.stackCheck": {
                    "type": "boolean",
                    "default": true,
                    "description": "Error on push/pop imbalances (unpaired pushes/pops, pop on empty stack, unbalanced ret)."
                },
                "nasmIde.libraries": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "c"
                    ],
                    "description": "Link libraries as -l flags without the prefix (e.g. \"c\" for -lc). Used for unresolved-extern detection and build/link tasks. Use the \"NASM IDE: Pick Link Libraries\" command to search your system.",
                    "scope": "resource"
                },
                "nasmIde.build.linker": {
                    "type": "string",
                    "enum": [
                        "ld",
                        "gcc"
                    ],
                    "default": "ld",
                    "description": "Linker used by the nasm-ide build task.",
                    "scope": "resource"
                },
                "nasmIde.build.sources": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "src/*.asm"
                    ],
                    "description": "Globs (relative to the workspace folder) of assembly sources to assemble and link.",
                    "scope": "resource"
                },
                "nasmIde.build.objDir": {
                    "type": "string",
                    "default": "obj",
                    "description": "Directory (relative to the workspace folder) for intermediate .o files.",
                    "scope": "resource"
                },
                "nasmIde.build.output": {
                    "type": "string",
                    "default": "bin/${workspaceFolderBasename}",
                    "description": "Linked output binary path (relative to the workspace folder).",
                    "scope": "resource"
                },
                "nasmIde.build.extraLdFlags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Extra flags passed to the linker (e.g. [\"-dynamic-linker\", \"/lib64/ld-linux-x86-64.so.2\"]).",
                    "scope": "resource"
                }
            }
        },
        "commands": [
            {
                "command": "nasmIde.restartServer",
                "title": "NASM IDE: Restart Language Server"
            },
            {
                "command": "nasmIde.showServerStatus",
                "title": "NASM IDE: Show Server Status"
            },
            {
                "command": "nasmIde.toggleDiagnostics",
                "title": "NASM IDE: Toggle Diagnostics"
            },
            {
                "command": "nasmIde.pickLibraries",
                "title": "NASM IDE: Pick Link Libraries"
            }
        ],
        "semanticTokenModifiers": [
            {
                "id": "pair0",
                "description": "First stack push/pop pair depth (outermost)."
            },
            {
                "id": "pair1",
                "description": "Second stack push/pop pair depth."
            },
            {
                "id": "pair2",
                "description": "Third stack push/pop pair depth."
            },
            {
                "id": "pair3",
                "description": "Fourth stack push/pop pair depth."
            },
            {
                "id": "pair4",
                "description": "Fifth stack push/pop pair depth."
            },
            {
                "id": "pair5",
                "description": "Sixth stack push/pop pair depth (cycles after this)."
            }
        ],
        "taskDefinitions": [
            {
                "type": "nasm-ide",
                "required": [
                    "operation"
                ],
                "properties": {
                    "operation": {
                        "type": "string",
                        "enum": [
                            "build",
                            "run",
                            "clean",
                            "make"
                        ],
                        "description": "The nasm-ide task operation. 'make' runs the workspace Makefile."
                    }
                }
            }
        ]
    },
    "scripts": {
        "compile": "tsc -p ./ && tsc -p ./server",
        "compile:client": "tsc -p ./",
        "compile:server": "tsc -p ./server",
        "watch": "tsc -watch -p ./ & tsc -watch -p ./server",
        "package": "npx -y @vscode/vsce package",
        "test": "node ./test/run.js && node ./test/client.js && node ./test/grammar.js"
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "@types/vscode": "^1.85.0",
        "typescript": "^5.6.0"
    },
    "dependencies": {
        "@vscode/debugadapter": "^1.68.0",
        "@vscode/debugprotocol": "^1.68.0",
        "vscode-languageclient": "^9.0.0"
    }
}
